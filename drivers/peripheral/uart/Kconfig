# Kconfig for Custom UART Driver
#

config SERIAL_CUSTOM_UART
	tristate "Custom UART Controller Driver"
	depends on HAS_IOMEM
	select SERIAL_CORE
	help
	  This driver supports the Custom UART controller.
	  It provides full UART functionality including interrupt-driven
	  TX/RX, hardware flow control, and optional DMA support.

	  To compile this driver as a module, choose M here: the
	  module will be called custom_uart.

	  If unsure, say N.

if SERIAL_CUSTOM_UART

config SERIAL_CUSTOM_UART_CONSOLE
	bool "Console on Custom UART"
	depends on SERIAL_CUSTOM_UART=y
	select SERIAL_CORE_CONSOLE
	help
	  If you say Y here, it will be possible to use the Custom UART
	  as the system console (the system console is the device which
	  receives all kernel messages and warnings and which allows
	  logins in single user mode).

	  Even if you say Y here, the currently visible virtual console
	  (/dev/tty0) will still be used as the system console by default,
	  but you can alter that using a kernel command line option such
	  as "console=ttyCustom0".

config SERIAL_CUSTOM_UART_DMA
	bool "DMA support for Custom UART"
	depends on SERIAL_CUSTOM_UART
	depends on DMADEVICES
	select DMA_ENGINE
	help
	  Say Y here if you want to use DMA for data transfers on the
	  Custom UART. This can significantly improve performance for
	  high-speed data transfers by offloading data movement to the
	  DMA controller.

	  If unsure, say N.

config SERIAL_CUSTOM_UART_DMA_BUFFER_SIZE
	int "DMA buffer size (bytes)"
	depends on SERIAL_CUSTOM_UART_DMA
	default 4096
	range 256 65536
	help
	  Set the size of DMA buffers for TX and RX.
	  Larger buffers can improve throughput but use more memory.
	  Default is 4096 bytes.

config SERIAL_CUSTOM_UART_NR_UARTS
	int "Maximum number of Custom UARTs"
	depends on SERIAL_CUSTOM_UART
	default 4
	range 1 16
	help
	  Set the maximum number of Custom UART ports supported.
	  This determines the size of the port array and the number
	  of /dev/ttyCustomN devices that can be created.

config SERIAL_CUSTOM_UART_RS485
	bool "RS-485 support"
	depends on SERIAL_CUSTOM_UART
	help
	  Say Y here if you want RS-485 serial line support.
	  This enables RTS control for RS-485 transceivers.

	  If unsure, say N.

endif # SERIAL_CUSTOM_UART
